---
import { DESIGNERS, ITEMS } from "../../data/items";

const shouldAnimate = DESIGNERS.length > 6;
---

<section class="bg-white border-t border-neutral-100 py-12 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 mb-8">
    <p class="text-[10px] font-bold tracking-[0.3em] uppercase text-neutral-400 mb-1">
      Quiénes nos acompañan
    </p>
    <h2 class="font-serif italic text-2xl font-bold text-black">
      Nuestros <span class="text-red-700">diseñadores</span>
    </h2>
  </div>

  <div class="relative">
    <div class="absolute left-0 top-0 bottom-0 w-20 bg-linear-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-20 bg-linear-to-l from-white to-transparent z-10 pointer-events-none"></div>

    <div
      class="designers-track flex gap-4 px-8 py-4"
      style={shouldAnimate ? "width: max-content" : ""}
      id="designersTrack"
      data-animate={shouldAnimate ? "true" : "false"}
    >
      {(shouldAnimate ? [...DESIGNERS, ...DESIGNERS] : DESIGNERS).map(d => {
        const items = ITEMS.filter(i => i.designer === d.name);
        const bgImg = items.find(i => i.isNew)?.img ?? items[0]?.img ?? "";
        const count = items.length;
        const colors = [...new Map(
          items.flatMap(i => i.colors).map(c => [c.hex, c])
        ).values()].slice(0, 4);

        return (
          <div class="designer-card group w-72 shrink-0 bg-white border border-neutral-100 rounded-2xl overflow-visible cursor-pointer transition-all duration-300 hover:border-red-700 hover:shadow-xl hover:-translate-y-1">

            <!-- Fondo blur sin overflow -->
            <div class="relative h-28 overflow-hidden rounded-t-2xl bg-neutral-900">
              {bgImg && (
                <img
                  src={bgImg}
                  alt=""
                  class="absolute inset-0 w-full h-full object-cover opacity-40 scale-110 transition-transform duration-500 group-hover:scale-125"
                  style="filter: blur(8px)"
                />
              )}
              <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-black/60"></div>

              <!-- Badge -->
              <div class="absolute top-3 right-3">
                {count > 0
                  ? <span class="text-[8px] font-bold tracking-widest uppercase bg-red-700 text-white px-2 py-1 rounded-full">{count} {count === 1 ? "prenda" : "prendas"}</span>
                  : <span class="text-[8px] font-bold tracking-widest uppercase bg-neutral-600 text-white px-2 py-1 rounded-full">Próximo</span>
                }
              </div>
            </div>

            <!-- Avatar fuera del overflow-hidden -->
            <div class="relative h-0">
              <div class="absolute -top-7 left-5 z-20 w-14 h-14 rounded-full overflow-hidden shadow-lg" style="border:3px solid white">
                <img
                  src={d.avatar}
                  alt={d.name}
                  class="w-full h-full object-cover"
                />
              </div>
            </div>

            <!-- Cuerpo -->
            <div class="pt-9 px-5 pb-5 bg-white rounded-b-2xl">
              <p class="text-sm font-bold text-black group-hover:text-red-700 transition-colors">
                {d.name}
              </p>
              <p class="text-[10px] font-bold tracking-widest uppercase text-red-700 mt-0.5 mb-2">
                {count > 0 ? `${count} ${count === 1 ? "prenda" : "prendas"}` : "Próximamente"}
              </p>
              <p class="text-[11px] text-neutral-400 leading-relaxed mb-3">
                {d.bio}
              </p>

              {colors.length > 0 && (
                <div class="flex items-center gap-1.5 mb-3">
                  {colors.map(c => (
                    <div
                      class="w-3 h-3 rounded-full border border-neutral-200"
                      style={`background:${c.hex}`}
                      title={c.name}
                    ></div>
                  ))}
                  <span class="text-[9px] text-neutral-300 ml-1">paleta</span>
                </div>
              )}

              <div class="flex items-center gap-2 text-[9px] font-bold tracking-widest uppercase text-neutral-300 group-hover:text-red-700 transition-colors">
                <div class="h-px bg-neutral-200 w-4 group-hover:w-8 group-hover:bg-red-600 transition-all duration-300"></div>
                Ver colección
              </div>
            </div>

          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .animate-marquee {
    animation: marquee 25s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<script>
  const track = document.getElementById("designersTrack");
  if (track?.dataset.animate === "true") {
    track.classList.add("animate-marquee");
  }
</script>