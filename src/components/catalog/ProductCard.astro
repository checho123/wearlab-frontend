---
import type { Item } from "../../data/items";

interface Props {
  item: Item;
}

const { item } = Astro.props;
---

<article
  class="group relative bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300 cursor-pointer"
  data-guid={item.guid}
  data-category={item.category}
>
  <!-- IMAGEN -->
  <div class="relative overflow-hidden bg-neutral-100" style="aspect-ratio:2/3">
    <img
      src={item.img}
      alt={item.name}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      onerror="this.parentElement.style.background='#f0f0f0'"
    />

    <!-- BADGES -->
    {item.isNew && (
      <span class="absolute top-3 left-3 text-[10px] font-bold tracking-widest uppercase bg-black text-white px-2 py-1 rounded-sm">
        Nuevo
      </span>
    )}

    <span class="absolute bottom-3 left-3 text-[10px] font-bold tracking-widest uppercase bg-amber-700 text-white px-2 py-1 rounded-sm flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-white inline-block"></span>
      3D
    </span>

    <!-- WISHLIST -->
    <button
      class="wish-btn absolute top-3 right-3 w-8 h-8 bg-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-neutral-400 hover:text-red-700 shadow-md"
      data-guid={item.guid}
      aria-label="Guardar"
    >
      ♡
    </button>

    <!-- QUICK ACTIONS -->
    <div class="absolute bottom-3 right-3 flex flex-col gap-1 opacity-0 group-hover:opacity-100 transition-all duration-200 translate-y-2 group-hover:translate-y-0">
      <button
        class="quick-view text-[10px] font-bold tracking-widest uppercase bg-white text-black px-3 py-1.5 rounded-sm hover:bg-neutral-100 transition-colors shadow-sm"
        data-guid={item.guid}
      >
        Ver
      </button>
      <button
        class="quick-3d text-[10px] font-bold tracking-widest uppercase bg-amber-700 text-white px-3 py-1.5 rounded-sm hover:bg-amber-600 transition-colors shadow-sm"
        data-guid={item.guid}
      >
        Ver en 3D
      </button>
    </div>
  </div>

  <!-- INFO -->
  <div class="pt-3 pb-4 px-4">
    <p class="text-[10px] font-bold tracking-widest uppercase text-red-700 mb-1">
      {item.designer}
    </p>
    <h3 class="font-serif italic text-base font-bold text-black leading-tight mb-1">
      {item.name}
    </h3>
    <p class="text-sm font-medium text-black">{item.price}</p>
  </div>
</article>