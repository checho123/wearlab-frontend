---
import { CATEGORIES } from "../../data/items";
---

<div class="sticky top-15 z-200 bg-white border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-8">
    <div class="flex items-center gap-0 overflow-x-auto scrollbar-none">
      <button
        class="cat-btn shrink-0 text-[10px] font-bold tracking-widest uppercase text-neutral-400 hover:text-black px-4 py-4 border-b-2 border-transparent hover:border-black transition-all duration-200 whitespace-nowrap bg-transparent cursor-pointer font-sans"
        data-cat="todos"
      >
        Todo
      </button>
      {CATEGORIES.map(cat => (
        <button
          class="cat-btn shrink-0 text-[10px] font-bold tracking-widets uppercase text-neutral-400 hover:text-black px-4 py-4 border-b-2 border-transparent hover:border-black transition-all duration-200 whitespace-nowrap bg-transparent cursor-pointer font-sans"
          data-cat={cat.key}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  const buttons = document.querySelectorAll(".cat-btn");

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      buttons.forEach(b => {
        b.classList.remove("text-black", "border-black");
        b.classList.add("text-neutral-400", "border-transparent");
      });
      btn.classList.add("text-black", "border-black");
      btn.classList.remove("text-neutral-400", "border-transparent");

      const cat = (btn as HTMLButtonElement).dataset.cat;
      window.dispatchEvent(new CustomEvent("wearlab:filterCat", { detail: { cat } }));
    });
  });

  buttons[0]?.classList.add("text-black", "border-black");
  buttons[0]?.classList.remove("text-neutral-400", "border-transparent");
</script>